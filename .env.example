# Copie este arquivo para ".env" e troque os valores (o .env NÃO vai para o Git).
#   cp .env.example .env

# Senha do administrador do Oracle (container)
ORACLE_PASSWORD=troque_esta_senha

# Senha do usuário "sobraboa" usado pela API
ORACLE_APP_PASSWORD=troque_esta_senha

# Chave de assinatura do JWT (mínimo de 32 caracteres)
JWT_KEY=troque-esta-chave-com-no-minimo-32-caracteres

# Senha do usuário admin criado automaticamente (admin@sobraboa.com)
ADMIN_SENHA=troque_esta_senha
